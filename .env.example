# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only configuration — never expose or commit real values
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RETELL_API_KEY=
OWNER_EMAIL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Platform OAuth applications only. Tenant access/refresh tokens and API keys live in Supabase Vault.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Arquitecto Técnico IA (solo servidor; nunca exponer al navegador)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
# Public browser identifier only; never place a Meta access token here.
NEXT_PUBLIC_META_PIXEL_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0

# Observability (provider to be selected before production)
SENTRY_DSN=
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPS_DIAGNOSTIC_SECRET=

# Global rate limiting (required in every deployed environment; no in-memory fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Durable workers and reconciliation
CRON_SECRET=
RECONCILIATION_BATCH_SIZE=100
WEBHOOK_QUEUE_BATCH_SIZE=50
GUARDIAN_QUEUE_ALERT_THRESHOLD=500

# Backup automation (run outside the web process)
DATABASE_URL=
BACKUP_OUTPUT_DIR=./backups
BACKUP_LAST_SUCCESS_AT=
RESTORE_DRILL_LAST_SUCCESS_AT=
CERTIFICATE_EXPIRY_AT=

# Optional uptime/monitoring destinations
BETTER_STACK_HEARTBEAT_URL=
