{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "corepack pnpm@11.9.0 install --frozen-lockfile",
  "buildCommand": "corepack pnpm@11.9.0 build",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/reconcile-calls",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-webhook-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/release-guardian",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/release-guardian?mode=daily",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/release-guardian?mode=weekly",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/analytics-rollup",
      "schedule": "5 * * * *"
    }
  ]
}
